# ==============================================================
# KONFIGURASI PENGIRIMAN EMAIL OTOMASI KURS (NABEL SAKHA GROUP)
# ==============================================================

# OPSI A: Jika menggunakan Akun Microsoft 365 / Outlook Kantor (nabelsakha.com)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=samsul@nabelsakha.com
SMTP_PASS=password_atau_app_password_anda
USE_TLS=true

# OPSI B: Jika menggunakan Akun Gmail Pribadi (Pakai App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=emailanda@gmail.com
# SMTP_PASS=app_password_16_karakter
# USE_TLS=true

# Nama Pengirim yang Muncul di Email
FROM_NAME=Laporan Kurs - Nabel Sakha Group

# Tujuan Penerima Laporan
# Selama masa uji coba, arahkan ke email Anda:
RECIPIENT_EMAIL=samsul@nabelsakha.com

# Jika nanti sudah fix dan ingin dialihkan ke Ferrian:
# RECIPIENT_EMAIL=ferri@nabelsakha.com

# Email Admin Penanggung Jawab untuk menerima alert jika terjadi error
ADMIN_EMAIL=samsul@nabelsakha.com
